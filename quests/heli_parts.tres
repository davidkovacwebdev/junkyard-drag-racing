[resource]
script = ExtResource("1_script")
id = &"heli_parts"
title = "Up, Up and Away"
giver = "Grandpa"
description = "Grandpa was staring at the sky, wondering what it'd be like if humans could fly. You told him they can. He had an idea.

He's riding shotgun, wheelchair in the back. Drive him to the helicopter crash site down south and do what he says."
objective = "Drive Grandpa to the Helicopter Crash Site and do what he says"
