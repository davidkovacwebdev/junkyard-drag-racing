[resource]
script = ExtResource("1_script")
id = &"chain_gang"
title = "Chains"
giver = "Grandpa"
description = "There's a new thing in town: a hill climbing race. Grandpa says it could be worth checking out, but first you need chains.

Buy a set of chains at the Shop ($200) and bring them back so he can set everything up."
objective = "Buy chains at the Shop"
objective_place = "Shop"
follow_ups = Array[ExtResource("1_script")]([ExtResource("3_next")])
