[resource]
script = ExtResource("1_script")
id = &"treasure_sweep"
title = "Beep Beep"
description = "Grandpa's metal detector works again. Somewhere around the X west of the docks, something big and metal is buried.

Drive out there, switch the detector on from your trunk (I) and listen. It's old, so it beeps at nothing now and then. Near the real thing it beeps steadily, faster the closer you get. When it's going nuts, press E to mark the spot."
objective = "Sweep around the X with the metal detector (I) and press E where it beeps fastest"
objective_place = "Treasure Area Spot"
follow_ups = [ExtResource("2_next")]
cutscene_ids = Array[StringName]([&"mark_spot"])
return_to_giver = false
