[resource]
script = ExtResource("1_script")
id = &"first_race"
title = "Make Me Proud"
giver = "Grandpa"
description = "With tears in his eyes, Grandpa says you're ready for your first drag race. He gave you the $40 entry fee.

Bolt the parts you've gathered onto your car in the garage, then sign up at the Drag Strip's booth for a $40 race. Make him proud."
objective = "Race your first drag race at the Drag Strip"
