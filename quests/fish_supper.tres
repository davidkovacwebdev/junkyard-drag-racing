[resource]
script = ExtResource("1_script")
id = &"fish_supper"
title = "Fish Supper"
giver = "Grandpa"
description = "Grandpa's spent all his money on beer and needs his dinner. He wants to go fishing. No rods, no bait, no plan he's telling you about.

Follow him. He's in his wheelchair, so try not to lose him."
objective = "Follow Grandpa to the fishing pier"
objective_place = "Grandpa"
reminder_line = "Just follow me, lad."
follow_ups = Array[ExtResource("1_script")]([ExtResource("2_next")])
