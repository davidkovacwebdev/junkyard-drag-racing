[resource]
script = ExtResource("1_script")
id = &"beer_run"
title = "Beer Run"
giver = "Grandpa"
description = "Even bloodier the second time. Grandpa laughed until he cried, then admitted he did absolutely nothing when he hit your car with his wrench.

He gave you $40. Buy a six-pack at the Shop, for yourself and for him, and bring it back."
objective = "Buy a six-pack at the Shop"
objective_place = "Shop"
start_cutscene = "res://cutscenes/grandpa_beer.tres"
start_money = 40
item_goal = ExtResource("2_beer")
reminder_line = "Beer, {player}. The Shop. A six-pack. It ain't rocket surgery."
turn_in_line = "Ahh, there they are. One for you, five for me. That's how sharin' works, look it up."
turn_in_sound = &"beer_crack"
