[resource]
script = ExtResource("1_script")
id = &"rally_debut"
title = "Safety Last"
giver = "Grandpa"
description = "A new rally track has opened, and Grandpa gave you his precious helmet for it. It's an old football helmet. He says it's meant to be a wheel, so it's waiting in the garage with your spare parts.

Go enter a race at the Rally, then let Grandpa know how it went."
objective = "Enter a race at the Rally"
objective_place = "Rally"
start_cutscene = "res://cutscenes/grandpa_helmet.tres"
race_goal_venue = "Rally"
reminder_line = "Rally's waitin', {player}. Helmet's optional. Always was."
turn_in_cutscene = "res://cutscenes/grandpa_rally_report.tres"
