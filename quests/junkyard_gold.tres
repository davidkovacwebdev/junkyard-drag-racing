[resource]
script = ExtResource("1_script")
id = &"junkyard_gold"
title = "Dig Deeper"
giver = "Chad"
description = "Chad thinks Eugen found something gold under the junkyard heap. Once the crane's fixed, meet him at the Junkyard, take the crane, and stir the heap up until something shows. Chad's paying for the digs.

Stir it with the claw, then press E to search the junk under the claw. Keep an eye out for anything shiny."
objective = "Stir the junkyard heap with the crane and search it"
objective_place = "Junkyard"
follow_ups = [ExtResource("2_next")]
return_to_giver = false
