[resource]
script = ExtResource("1_script")
id = &"derby_debut"
title = "Wrap It Up"
giver = "Grandpa"
description = "Grandpa handed you a roll of bubble wrap and told you to wrap your car in it. It's waiting in the garage with your spare parts.

The Demolition Derby is open. Go enter a race there and make Gramps proud, then let him know how it went."
objective = "Enter a race at the Demolition Derby"
objective_place = "Demolition Derby"
unlocks = Array[ExtResource("1_script")]([ExtResource("2_next")])
race_goal_venue = "Demolition Derby"
reminder_line = "Derby, {player}. Wrap that heap up and go smash somethin'."
turn_in_cutscene = "res://cutscenes/grandpa_derby_report.tres"
