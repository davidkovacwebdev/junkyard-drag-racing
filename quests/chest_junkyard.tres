[resource]
script = ExtResource("1_script")
id = &"chest_junkyard"
title = "Show and Tell"
description = "The Junkyard Treasure is real, and it's in your trunk. Eugen spent forty years at that junkyard dreaming about it.

Take it there and open it up."
objective = "Bring the treasure chest to the Junkyard"
objective_place = "Junkyard"
