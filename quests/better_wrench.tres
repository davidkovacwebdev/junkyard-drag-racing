[resource]
script = ExtResource("1_script")
id = &"better_wrench"
title = "The Better Wrench"
giver = "Grandpa"
description = "Grandpa needs a new wrench. There doesn't seem to be one under the bench. Granpa said that just so he could bust a rhyme.

Go find a new one"
objective = "Find Grandpa's better wrench ( Try the shop )"
objective_place = "Shop"
start_cutscene = "res://cutscenes/grandpa_intro.tres"
item_goal = ExtResource("2_wrench")
reminder_line = "Where's my wrench?! This chair ain't gonna fix itself! ...Well, it might. I've seen things."
turn_in_line = "Now THAT'S a wrench. *CLANG* ...Good as new. Here, take my old generator. It's better than that lawn mower you call an engine. Go bolt it on in the garage."
reward_part = "res://scenes/parts/engines/engine_generator.tscn"
follow_ups = Array[ExtResource("1_script")]([ExtResource("3_next")])
