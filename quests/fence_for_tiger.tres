[resource]
script = ExtResource("1_script")
id = &"fence_for_tiger"
title = "Fenced In"
giver = "Grandpa"
description = "Grandpa has his carrots and his paint, and now he wants a fence to paint. Where from? \"I dunno, I know a farm has one.\"

Ram the farm's fence until a piece of it comes loose, then bring it to Grandpa."
objective = "Ram the farm's fence until a piece comes loose"
