[resource]
script = ExtResource("1_script")
id = &"crane_fish"
title = "Gone Fishin'"
giver = "Grandpa"
description = "Vern let you at his crane. Take it out back, fish something out of the heap and show it to Grandpa. Try not to come back empty-handed."
objective = "Fish something out of the junk heap with the crane"
objective_place = "Junkyard"
unlocks = Array[ExtResource("1_script")]([ExtResource("2_next")])
reminder_line = "Well? Didja fish anything up yet? *hic*"
turn_in_line = "{part}??? In my time I was able to fish GOLD outta there!"
empty_handed_line = "N-nothin'?! *sniff* You came back with NOTHIN'?! You're a d-d-disappointment, {player}... a disappointment to me, to this family... t-to the CRANE! *sob*"
