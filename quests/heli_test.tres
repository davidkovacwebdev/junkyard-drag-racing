[resource]
script = ExtResource("1_script")
id = &"heli_test"
title = "Test Pilot"
giver = "Grandpa"
description = "Grandpa built a one-man helicopter out of the engine and tail rotor you brought him, and a tin bathtub. Super safe, he says. Same as riding a bicycle.

Climb in and take it up for a spin."
objective = "Climb into Grandpa's helicopter (E) and take it up for a spin"
objective_place = "Grandpa"
follow_ups = Array[ExtResource("1_script")]([ExtResource("2_next")])
cutscene_ids = Array[StringName]([&"mini_heli_crash"])
start_cutscene = "res://cutscenes/grandpa_mini_heli.tres"
reminder_line = "Well? Climb in, {player}. It don't bite."
turn_in_cutscene = "res://cutscenes/grandpa_mini_heli_report.tres"
