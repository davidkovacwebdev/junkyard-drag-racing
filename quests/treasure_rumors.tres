[resource]
script = ExtResource("1_script")
id = &"treasure_rumors"
title = "Ask Around"
giver = "Chad"
description = "The gold under the junkyard was a fake, like the nickel. Somebody's planting fake treasure, but there's a real one out there somewhere. Chad's taking the fakes to his husband and having a weekend out with his honey.

Snoop around town and ask anyone you can talk to about the Junkyard Treasure. Meet Chad in 2 days."
objective = "Ask around town about the Junkyard Treasure"
side_quests = [ExtResource("2_side")]
cutscene_ids = Array[StringName]([&"farmer_coins", &"smith_coins", &"smith_confront"])
return_to_giver = false
