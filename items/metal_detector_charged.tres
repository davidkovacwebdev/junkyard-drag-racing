[resource]
script = ExtResource("1_script")
id = &"metal_detector_charged"
display_name = "Metal Detector"
description = "Grandpa's old metal detector, running on a battery pulled out of a toy car motor. Use it to switch it on (or off): it beeps faster the closer it gets to buried metal. And now and then at nothing at all."
