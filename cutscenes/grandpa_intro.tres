lines = ["Ever since that trash bag crushed my legs I can't do SHIT!", "{player}! Go get me the better wrench.", "This one's bent ever since I used it to hit that wench.", "You can find the new one under the bench.", "Or if it's not there... I dunno. Go find it!"]
