; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Junkyard drag racing"
run/main_scene="res://scenes/menu/boot_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.8, 0.68, 0.49, 1)
boot_splash/image="res://assets/boot_splash.png"
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

AudioSettings="*res://autoload/audio_settings.gd"
Music="*res://autoload/music.gd"
Sfx="*res://autoload/sfx.gd"
DisplaySettings="*res://autoload/display_settings.gd"
ScrapCursor="*res://autoload/scrap_cursor.gd"
PartDatabase="*res://autoload/part_database.gd"
Inventory="*res://autoload/inventory.gd"
WorldState="*res://autoload/world_state.gd"
PlayerProfile="*res://autoload/player_profile.gd"
SaveSystem="*res://autoload/save_system.gd"
DayNightCycle="*res://autoload/day_night_cycle.gd"
Weather="*res://autoload/weather.gd"
RaceProgression="*res://autoload/race_progression.gd"
DevMenu="*res://scenes/ui/dev_menu.tscn"
RandomRace="*res://scripts/ui/random_race_popup.gd"
FpsCounter="*res://autoload/fps_counter.gd"
Cutscenes="*res://autoload/cutscenes.gd"
Quests="*res://autoload/quests.gd"
Journal="*res://autoload/journal.gd"
Trunk="*res://autoload/trunk.gd"
Drunk="*res://autoload/drunk.gd"
WorldMap="*res://autoload/world_map.gd"
QuestDebugger="*res://autoload/quest_debugger.gd"
SceneLoader="*res://autoload/scene_loader.gd"
Funeral="*res://autoload/funeral.gd"
FunctionKeyAliases="*res://autoload/function_key_aliases.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/character_creator/plugin.cfg")

[gui]

theme/custom="res://themes/scrap_theme.tres"
theme/custom_font="res://assets/fonts/Poco.ttf"

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
