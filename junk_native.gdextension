[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://rust/target/debug/libjunk_native.so"
linux.release.x86_64 = "res://rust/target/release/libjunk_native.so"
windows.debug.x86_64 = "res://rust/target/debug/junk_native.dll"
windows.release.x86_64 = "res://rust/target/release/junk_native.dll"
macos.debug = "res://rust/target/debug/libjunk_native.dylib"
macos.release = "res://rust/target/release/libjunk_native.dylib"
